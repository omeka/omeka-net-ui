{
  "name": "@omeka/ui",
  "version": "1.0.0",
  "description": "Shared design system for omeka.net: tokens, base styles, and the components that appear on more than one site.",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/omeka/omeka-net-ui.git"
  },
  "files": [
    "scss",
    "js",
    "assets",
    "data"
  ],
  "scripts": {
    "dev": "sass --watch preview/preview.scss preview/preview.css --no-source-map",
    "build:preview": "sass preview/preview.scss preview/preview.css --no-source-map",
    "check": "sass preview/preview.scss preview/.check.css --no-source-map && rm preview/.check.css"
  },
  "devDependencies": {
    "sass": "^1.101.0"
  }
}
